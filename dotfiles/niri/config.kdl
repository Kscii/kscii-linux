// ThinkPad 键盘优先 niri 合成器配置
// 配色：纯黑（#000000）+ ThinkPad 红（#E2000F）
// Mod = Super（Win 键）

// ─── 环境变量 ─────────────────────────────────────────────────────────────

environment {
    // Wayland 工具包后端
    QT_QPA_PLATFORM "wayland"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    GDK_BACKEND "wayland,x11"

    // Electron / Chromium Wayland
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    NIXOS_OZONE_WL "1"

    // 桌面环境标识
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"

    // 输入法
    XMODIFIERS "@im=fcitx"
    QT_IM_MODULE "fcitx"
    GTK_IM_MODULE "fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "ibus"

    // 光标
    XCURSOR_THEME "Adwaita"
    XCURSOR_SIZE "24"

    DISPLAY ":12"
}

// ─── 输入设备 ─────────────────────────────────────────────────────────────

input {
    keyboard {
        xkb {
            layout "us"
            // options "ctrl:nocaps"
        }
        numlock
        repeat-delay 300
        repeat-rate 30
    }

    touchpad {
        tap
        natural-scroll
        // dwt
        accel-speed 0.2
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    trackpoint {
        natural-scroll
        accel-speed 0.3
        scroll-method "on-button-down"
        scroll-button 274
    }

    warp-mouse-to-focus
}

// ─── 输出（显示器）────────────────────────────────────────────────────────

output "eDP-1" {
    mode "2880x1800@60.000"
    scale 1.5
    transform "normal"
}

// ─── 布局 ─────────────────────────────────────────────────────────────────

layout {
    gaps 12

    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#E2000F"
        inactive-color "#2a2a2a"
    }

    border {
        off
        width 2
        active-color "#E2000F"
        inactive-color "#2a2a2a"
    }

    shadow {
        // OLED 省电默认关闭
    }

    struts {
        // left 0
        // right 0
        // top 0
        // bottom 0
    }
}

// ─── 启动项 ───────────────────────────────────────────────────────────────

// 状态栏
spawn-at-startup "waybar"

// 纯黑背景
spawn-at-startup "swaybg" "-c" "#000000"

// Polkit 认证代理
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// 输入法
spawn-at-startup "fcitx5" "-d"

// 通知守护进程
spawn-at-startup "mako"

// 空闲管理
spawn-sh-at-startup "exec $HOME/.local/bin/swayidle-start.sh"

// ─── 杂项 ─────────────────────────────────────────────────────────────────

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

animations {
    slowdown 0.8
}

// ─── 窗口规则 ─────────────────────────────────────────────────────────────

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"xdg-desktop-portal"#
    open-floating true
}

window-rule {
    match app-id="thunar" title=r#"(File Operation|Copying|Moving|Deleting)"#
    open-floating true
}

window-rule {
    match app-id=r#"(polkit|gcr-prompter|seahorse)"#
    open-floating true
}

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

// ─── 快捷键 ───────────────────────────────────────────────────────────────

binds {
    // 帮助
    Mod+Shift+Slash { show-hotkey-overlay; }

    // 应用启动
    Mod+T hotkey-overlay-title="终端: kitty" { spawn "kitty"; }
    Mod+B hotkey-overlay-title="浏览器: firefox" { spawn "firefox"; }
    Mod+E hotkey-overlay-title="文件管理器: yazi" { spawn-sh "kitty --title 'File Manager' -e yazi"; }
    Mod+Shift+E hotkey-overlay-title="文件管理器 GUI: thunar" { spawn "thunar"; }

    // 启动器 / 概览 / 窗口切换
    Alt+Space hotkey-overlay-title="应用启动器: fuzzel" { spawn "fuzzel"; }
    Mod+O repeat=false hotkey-overlay-title="概览" { toggle-overview; }

    Alt+Tab repeat=false hotkey-overlay-title="上一个窗口" { focus-window-previous; }
    Alt+Shift+Tab repeat=false hotkey-overlay-title="概览" { toggle-overview; }

    Mod+Tab repeat=false hotkey-overlay-title="上一个工作区" { focus-workspace-previous; }

    // 窗口管理
    Mod+Q repeat=false hotkey-overlay-title="关闭窗口" { close-window; }
    Mod+F hotkey-overlay-title="最大化列" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="全屏" { fullscreen-window; }
    Mod+M hotkey-overlay-title="扩展至边缘" { maximize-window-to-edges; }

    Mod+V hotkey-overlay-title="切换浮动" { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+W hotkey-overlay-title="切换标签页显示" { toggle-column-tabbed-display; }

    Mod+C hotkey-overlay-title="居中列" { center-column; }
    Mod+Alt+C hotkey-overlay-title="居中窗口" { center-window; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+R hotkey-overlay-title="循环列宽" { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // 列堆叠
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // 焦点导航：vim 风格
    Mod+H { focus-column-left-or-last; }
    Mod+L { focus-column-right-or-first; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    // 移动窗口 / 列
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }

    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }

    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }

    // 聚焦显示器
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+L { focus-monitor-right; }
    Mod+Shift+J { focus-monitor-down; }
    Mod+Shift+K { focus-monitor-up; }

    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+Up { focus-monitor-up; }

    // 移动到显示器
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }

    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }

    // 工作区
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }

    Mod+Grave hotkey-overlay-title="上一个工作区" { focus-workspace-previous; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }

    // 移动当前窗口到工作区
    Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-window-to-workspace-up; }

    Mod+Ctrl+1 { move-window-to-workspace 1; }
    Mod+Ctrl+2 { move-window-to-workspace 2; }
    Mod+Ctrl+3 { move-window-to-workspace 3; }
    Mod+Ctrl+4 { move-window-to-workspace 4; }
    Mod+Ctrl+5 { move-window-to-workspace 5; }
    Mod+Ctrl+6 { move-window-to-workspace 6; }

    // 重排工作区
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }

    // 截图 / 录屏
    Print { screenshot; }
    Shift+Print { screenshot-window; }
    Ctrl+Print { screenshot-screen; }

    Mod+Print { spawn-sh "~/.local/bin/niri-record.sh region"; }
    Mod+Shift+Print { spawn-sh "~/.local/bin/niri-record.sh screen"; }

    // 系统
    Mod+Alt+L hotkey-overlay-title="锁屏" { spawn-sh "~/.local/bin/lock-session"; }
    Mod+Shift+S hotkey-overlay-title="睡眠" { spawn-sh "~/.local/bin/suspend-session"; }
    Mod+Shift+P hotkey-overlay-title="关闭显示器" { power-off-monitors; }
    Mod+Shift+Q hotkey-overlay-title="退出 niri" { quit; }
    Ctrl+Alt+Delete { quit; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // 重新加载配置
    // 你的 niri 版本不接受 { load-config-file; } 作为配置动作，所以用 CLI。
    Mod+Shift+C hotkey-overlay-title="重载 niri 配置" { spawn "niri" "msg" "action" "load-config-file"; }

    // 媒体键
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "~/.local/bin/volume.sh up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "~/.local/bin/volume.sh down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "~/.local/bin/volume.sh mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "~/.local/bin/volume.sh mic-mute"; }

    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }

    // 亮度键
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // 滚动绑定
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-window-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-window-to-workspace-up; }

    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }

    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }

    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
}
